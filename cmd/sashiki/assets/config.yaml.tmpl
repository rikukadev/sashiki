# sashikid の設定。sashiki init が生成した初期値。キーの一覧は docs/SPEC.md 21 章。
# 未知のキーは起動時にエラーになる(綴りを間違えても黙って無視しない)。
listen:
  api: "127.0.0.1:8080"     # Web UI もここ (GET /)
  proxy: "0.0.0.0:3306"
  metrics: "127.0.0.1:9100"

state_db: /var/lib/sashiki/state.db
run_dir: /run/sashiki          # socket / sentinel を置く実行時領域
log_dir: /var/log/sashiki      # ログの基点(hooks.log_dir 等は未設定ならここから派生)
log_format: text   # text | json(構造化ログ。operation ログに operation_id / branch が付く)
domain: sashiki.internal

storage:
  backend: ebs-zfs
  high_watermark: 0.8        # pool使用率がこれを超えるとwarning(メトリクス)
  critical_watermark: 0.95   # これを超えるとcreate/wake/recreateを拒否
  # default_storage_quota: 10G # branch ごとの refquota(暴走で pool を食い潰さない。空=無制限)
  ebs-zfs:
    pool: {{.Pool}}
    base_dataset: {{.Pool}}/base
    branch_parent: {{.Pool}}/branches
    baseline_snapshot: baseline
    # systemd デプロイでは sashikid は User=sashiki で動き、zfs は sudoers 経由で
    # 実行する(sashiki init が /etc/sudoers.d/sashiki を生成)。root 直で動かす
    # 構成(コンテナ等)では false にしてよい。
    sudo: true

engine:
  type: mysql
  mysql:
    port_range: [3401, 3600]
    app_user: dev            # 方式A の app credential(旧名 proxy_user も可)
    # init がランダム生成する(--app-pass で固定可)。proxy と baseline import の
    # 両方がこれを使う。変更したら baseline のユーザーも合わせて変えること。
    app_pass: {{.AppPass}}
    # per-branch の <branch>.env は sashikid(User=sashiki)が書き、mysqld@.service が
    # 読む。/run/sashiki は sashikid.service の RuntimeDirectory=sashiki で sashiki 所有
    # として作られる(/etc は root 所有で書けないため #177)。
    env_dir: /run/sashiki
    # systemd デプロイでは mysqld を systemctl 経由で起動する(要 root=sudoers)。
    sudo: true
  # postgres を使う場合(接続はプロキシでなく直接ポート、sashiki show <name> で確認):
  #   - listen.proxy: "" にする(プロキシは MySQL 専用)
  #   - idle_stop_after / delete_after_idle は接続追跡ができないため自動で無効化される
  #   - リモート接続には listen_addresses を広げ、base の pg_hba.conf に host 行が必要
  # postgres:
  #   port_range: [5433, 5632]
  #   bin_dir: /usr/lib/postgresql/16/bin
  #   env_dir: /run/sashiki
  #   listen_addresses: 127.0.0.1
  #   sudo: true

branches:
  name_pattern: "^[a-z0-9-]{1,32}$"
  max_branches: 50
  lazy_create: true
  lazy_create_max_wait: 20s
  idle_stop_after: 30m      # 接続なしで mysqld を停止(データは残る、再接続で起床)
  delete_after_idle: 168h   # 7日間接続なしで削除。PR close 取りこぼしの保険
  operation_retention: 168h # 完了した operation を7日で掃除(0=無期限)
  error_retention: 72h      # error 状態になって3日で削除(調査の猶予。0=残す)。lease(--ttl)は error でも効く
  # profile: 用途ごとに idle lifecycle を変える。branch は create --profile P で
  # 1つ持ち、reaper はその profile の閾値を使う(未設定フィールドは上の global に戻る)。
  # lease(絶対期限)は profile ではなく `sashiki create --ttl 7d` /
  # `sashiki lease renew <name> --for 7d` で明示的に付ける(使用中でも期限で回収)。
  default_profile: preview
  profiles:
    preview: { idle_stop_after: 30m, delete_after_idle: 168h }
    ci:      { idle_stop_after: 5m,  delete_after_idle: 1h }
    sandbox: { idle_stop_after: 1h,  delete_after_idle: 720h }

baseline:
  # refresh の実行方法(#101): refresh_script があればそれを実行。
  # 無ければ source_dir/*.sql を組み込みローダーが名前順に冪等適用する
  # (適用記録は sashiki_meta._migrations。mysql エンジンのみ)
  # refresh_script: /etc/sashiki/refresh.sh
  # source_dir: /etc/sashiki/baseline-src
  # source_db: app            # 各 SQL 実行時に選択する DB(USE を書かない migration 向け)
  require_masked: false      # true にすると masked でない baseline の publish を拒否
  require_validated: false   # true にすると validate 未通過の publish を拒否
  validate_port: 3999
  # masked_sentinel: 未設定なら run_dir/baseline-masked に派生
  keep_last: 3               # baseline GC で残す直近 N
  retention: 0s              # baseline GC で残す期間(0=無期限)

hooks:
  dir: /etc/sashiki/hooks
  # log_dir: 未設定なら log_dir/hooks に派生

auth:
  api_token_env: SASHIKI_API_TOKEN   # このenv変数からBearerトークンを読む
  # api_token_ssm: /sashiki/api-token # 設定するとSSM(SecureString)から読み、envより優先(リモート運用)
