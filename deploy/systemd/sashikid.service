[Unit]
Description=sashiki daemon
After=network.target zfs-mount.service

[Service]
User=sashiki
Group=sashiki
# /run/sashiki を sashiki 所有で用意する(config の run_dir と per-branch <branch>.env
# の置き場。/etc は root 所有で書けないため #177)。0755 で mysqld@(User=mysql)も読める。
RuntimeDirectory=sashiki
RuntimeDirectoryMode=0755
EnvironmentFile=-/etc/sashiki/sashikid.env
ExecStart=/usr/local/bin/sashikid --config /etc/sashiki/config.yaml
Restart=on-failure
# 停止時、sashikid は実行中の operation(create / reset / delete …)を最大 10 分待つ
# (#303)。systemd 既定の 90 秒で SIGKILL されると途中で死ぬので、それより長くする。
TimeoutStopSec=660

[Install]
WantedBy=multi-user.target

# sashiki ユーザーの sudoers は sashiki init が /etc/sudoers.d/sashiki に生成する
# (実呼び出し形に合わせたパス制限付き。cmd/sashiki/hardening.go 参照 #78)。
