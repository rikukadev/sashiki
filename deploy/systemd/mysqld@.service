[Unit]
Description=sashiki MySQL instance %i
After=network.target zfs-mount.service

[Service]
Type=simple
User=mysql
Group=mysql
# <branch>.env は sashikid(User=sashiki)が /run/sashiki に書く(RuntimeDirectory、#177)。
EnvironmentFile=/run/sashiki/%i.env
ExecStart=/usr/sbin/mysqld $MYSQLD_DEFAULTS \
  --datadir=${DATADIR} \
  --bind-address=127.0.0.1 \
  --port=${PORT} \
  --socket=/tmp/mysql-%i.sock \
  --pid-file=/tmp/mysql-%i.pid \
  --log-error=/var/log/sashiki/%i.err \
  --innodb-buffer-pool-size=256M \
  --skip-mysqlx
Restart=no
# 停止に時間がかかっても SIGKILL しない(#245)。systemd 既定の 90 秒で
# 強制終了されると、buffer pool の大きいブランチは書き出しが終わらず
# 次回起動が crash recovery になる。@init snapshot も dirty になりうる。
TimeoutStopSec=600
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
