#!/usr/bin/env bash
# sashiki EC2 の初期化(仕様17章)。install.sh → sashiki init --yes まで走らせ、
# 完了時点で sashikid が稼働する。シークレットは IAM ロール経由で取得し、
# ディスクの平文設定には残さない(API トークンは環境変数、dev パスワードは init が使う)。
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
# 起動直後は unattended-upgrades / cloud-init が dpkg ロックを握っていることがある。
# DPkg::Lock::Timeout でロック解放を最大 5 分待ち、set -e での即中断を避ける(#192)。
APT_LOCK="-o DPkg::Lock::Timeout=300"
apt-get $APT_LOCK update -y
# awscli は Ubuntu 24.04 の apt に無いため公式 v2 を導入する(#164)。unzip が要る。
apt-get $APT_LOCK install -y curl ca-certificates unzip jq
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

# region は IMDSv2 から取得(Terraform に依存させない)。
IMDS_TOKEN="$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")"
REGION="$(curl -sS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/placement/region)"
POOL="${pool}"

# --- シークレット取得(instance role)。set +x で cloud-init ログへの平文残留を防ぐ(#165) ---
set +x
DEV_PASSWORD="$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "${dev_secret_arn}" --query 'SecretString' --output text)"
set -x

# --- sashiki のインストール(deb)。sashiki_ref がタグなら releases の直リンクで取得する
#     (latest API 経由のパース失敗を避ける、#166)。リポジトリは public なので token は
#     要らない。以前の token 入力(#342)は user-data と cloud-init ログに平文で残るため
#     削除した(#342)。private で使う場合は AMI に deb を焼くか、S3 経由で配る ---
curl -fsSL "https://raw.githubusercontent.com/rikukadev/sashiki/${sashiki_ref}/install.sh" \
  | SASHIKI_RELEASE="${sashiki_ref}" bash

# --- sashiki_ref と実際に入った版が食い違っていないか確認(ref の上げ忘れ検出、#193)---
%{ if sashiki_ref != "latest" && sashiki_ref != "main" ~}
INST_VER="$(sashiki version 2>/dev/null || true)"
case "$INST_VER" in
  *"${trimprefix(sashiki_ref, "v")}"*) : ;;  # 一致(version は "sashiki X.Y.Z+commit")
  *) echo "sashiki: 警告 install された版 [$INST_VER] が sashiki_ref=${sashiki_ref} と一致しません。ref の上げ忘れの可能性があります。" >&2 ;;
esac
%{ endif ~}

# --- データ EBS のデバイスを解決する。Nitro 世代は /dev/xvdf でなく /dev/nvmeXn1 に
#     見えるため、EBS の volume id から by-id パスを引いて実デバイスを特定する(#163)。
#     symlink を自作すると zpool がパーティション名を見失うので、canonical な実体を使う。
VID="$(echo "${data_volume_id}" | tr -d '-')"   # vol-0abc... → vol0abc...
BYID="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${VID}"
DATA_DEVICE=""
for i in $(seq 1 60); do
  if [ -e "$BYID" ]; then
    DATA_DEVICE="$(readlink -f "$BYID")"
    break
  fi
  if [ -b "${data_device}" ]; then   # 非 Nitro フォールバック(/dev/xvdf 等)
    DATA_DEVICE="${data_device}"
    break
  fi
  sleep 5
done
if [ -z "$DATA_DEVICE" ]; then
  echo "sashiki: data volume ${data_volume_id} のデバイスが見つかりません" >&2
  exit 1
fi

# --- init: zpool 作成・mysql セットアップ・config 生成まで(--yes で非対話) ---
sashiki init --yes --pool "$POOL" --device "$DATA_DEVICE"

# state.db(port/origin/operation/token 等の台帳)を root volume に置くと EC2
# 差し替えで失われる。データ EBS 上の専用 dataset へ置き、既存 pool の import
# 時にも同じ台帳を使う。SSM Association の既存環境移行と同じ冪等スクリプト。
install -m 0755 /dev/stdin /usr/local/sbin/sashiki-persist-state <<'SASHIKI_PERSIST_STATE'
${persist_state_script}
SASHIKI_PERSIST_STATE
SASHIKI_POOL="$POOL" /usr/local/sbin/sashiki-persist-state

# init が生成した config の app credential を Secrets Manager の値へ差し替える(#165: 平文回避)。
set +x
CONFIG=/etc/sashiki/config.yaml
if [ -f "$CONFIG" ]; then
  # init は app_user / app_pass を生成する(旧名 proxy_user / proxy_pass も許容)。
  sed -i -E "s/^( *)(app_user|proxy_user):.*/\1app_user: ${proxy_user}/" "$CONFIG"
  sed -i -E "s#^( *)(app_pass|proxy_pass):.*#\1app_pass: $DEV_PASSWORD#" "$CONFIG"
  # init の既定は loopback(127.0.0.1:8080)。それだと SG で 8080 を開けても
  # 出力の api_url に届かない(#286)。allowed_sg_ids からの Bearer 認証経路を
  # 成立させるため全 IF で listen する。loopback 無認証の判定は接続元アドレスで
  # 行うので、この変更で VPC 内からの無認証アクセスが増えることはない。
  # metrics(9100)は loopback のまま(認証が無い)。
  sed -i -E 's/^( *)api: *"127\.0\.0\.1:8080"/\1api: "0.0.0.0:8080"/' "$CONFIG"
  grep -qE '^ *api: *"0\.0\.0\.0:8080"' "$CONFIG" \
    || echo "sashiki: 警告 listen.api を 0.0.0.0:8080 に書き換えられなかった。api_url には届かない" >&2
fi

# --- CI / Action 用の API トークン(#340) ---
# state.db(data EBS に永続化済み)に branches scope で発行し、平文は SSM(api_token_ssm_path)
# にだけ置く。list / revoke / rotate は `sashiki token` で行える。置換後の EC2 でも同じ
# state.db なので、同名を revoke してから発行し直す(平文は旧インスタンスと共に消えている)。
set +x
sashiki token revoke ci >/dev/null 2>&1 || true
CI_TOKEN="$(sashiki token create --name ci --scope branches | grep -oE 'sashiki_[0-9a-f]{64}')"
[ -n "$CI_TOKEN" ] || { echo "sashiki: branches トークンを発行できませんでした" >&2; exit 1; }
aws ssm put-parameter --region "$REGION" --name "${api_token_ssm_path}" \
  --type SecureString --value "$CI_TOKEN" --overwrite > /dev/null
unset CI_TOKEN
set -x

# --- 運用者向け admin トークン(opt-in)。SASHIKI_API_TOKEN として sashikid の環境に渡す ---
install -d -m 0755 /etc/sashiki
umask 077
%{ if admin_token_ssm_path != "" ~}
set +x
ADMIN_TOKEN="$(aws ssm get-parameter --with-decryption --region "$REGION" \
  --name "${admin_token_ssm_path}" --query 'Parameter.Value' --output text)"
# deb の sashikid.service が読む EnvironmentFile と同じ名前にする(#328: 以前は
# /etc/sashiki/env に書いて drop-in で補っていた)。
printf 'SASHIKI_API_TOKEN=%s\n' "$ADMIN_TOKEN" > /etc/sashiki/sashikid.env
unset ADMIN_TOKEN
%{ else ~}
# admin トークンは発行しない(admin_token = false)。admin 操作はホスト上の loopback から
# (`aws ssm start-session` → `sashiki ...`)。env ファイルは空にして旧 admin トークンを残さない。
: > /etc/sashiki/sashikid.env
%{ endif ~}
set -x
# unit が EnvironmentFile=/etc/sashiki/sashikid.env を読む前提。無ければ drop-in で補う。
if ! grep -q "EnvironmentFile=-\?/etc/sashiki/sashikid.env" /etc/systemd/system/sashikid.service 2>/dev/null; then
  install -d -m 0755 /etc/systemd/system/sashikid.service.d
  cat > /etc/systemd/system/sashikid.service.d/10-env.conf <<'EOF'
[Service]
EnvironmentFile=/etc/sashiki/sashikid.env
EOF
  systemctl daemon-reload
fi
systemctl enable --now sashikid

# baseline import は運用者の手順(ダンプが要るため)。ここでは sashikid 稼働までを保証する。
echo "sashiki: bootstrap done. Next: sashiki baseline import --from <dump.sql> [--db <name>]"
